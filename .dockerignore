# flyctl launch added from .gitignore
# Python
**/__pycache__
**/*.py[cod]
**/*.pyo
**/*.pyd
**/*.egg
**/*.egg-info
**/dist
**/build
**/eggs
**/parts
**/var
**/sdist
**/develop-eggs
**/.installed.cfg
**/lib
**/lib64
**/wheels

# Virtual environments
**/.venv
**/venv
**/env
**/ENV

# Environment variables
**/.env
**/.env.*
!**/.env.example

# pytest
**/.pytest_cache
**/.coverage
**/htmlcov
**/coverage.xml
**/*.cover

# mypy / type checkers
**/.mypy_cache
**/.dmypy.json
**/.pytype

# IDEs
**/.vscode
**/.idea
**/*.swp
**/*.swo

# macOS
**/.DS_Store

# Logs
**/*.log

# flyctl launch added from .idea/.gitignore
# Default ignored files
.idea/shelf
.idea/workspace.xml
# Editor-based HTTP Client requests
.idea/httpRequests
# Ignored default folder with query files
.idea/queries
# Datasource local storage ignored files
.idea/dataSources
.idea/dataSources.local.xml

# flyctl launch added from .pytest_cache/.gitignore
# Created by pytest automatically.
.pytest_cache/**/*
fly.toml
